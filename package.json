{
  "name": "site-creator-vinext-starter",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-pnpm.sh",
    "dev": "node scripts/run-framework.mjs dev",
    "build": "node scripts/run-framework.mjs build",
    "start": "node --import ./scripts/sites-env.mjs ./node_modules/wrangler/bin/wrangler.js dev --config dist/server/wrangler.json --local --persist-to .wrangler/state --ip 127.0.0.1 --inspector-port 0",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "typecheck": "tsc --noEmit --pretty false",
    "audit:ui": "node scripts/audit-ui-alignment.mjs",
    "audit:presentation": "node scripts/audit-module-presentation.mjs",
    "audit:integrity": "node --experimental-strip-types scripts/audit-system-integrity.mjs",
    "audit:alignment": "node --experimental-strip-types scripts/verify-system-alignment.mjs && node --experimental-strip-types scripts/verify-tenant-alignment.mjs",
    "audit:language": "node scripts/audit-product-language.mjs",
    "audit:browser": "node scripts/audit-browser-surfaces.mjs",
    "audit:release": "pnpm run typecheck && pnpm run audit:language && node scripts/audit-release-surface.mjs && pnpm run audit:integrity && pnpm run audit:alignment",
    "audit:e2e": "node scripts/audit-e2e-contract.mjs",
    "verify:commercial": "node --experimental-strip-types scripts/verify-commercial-v1.mjs",
    "verify:company-ai-assets": "node --experimental-strip-types scripts/verify-company-ai-personal-assets.mjs",
    "verify:creation-flows": "node scripts/verify-creation-flows.mjs",
    "verify:operations-intake": "node scripts/verify-operations-intake.mjs",
    "verify:operating-profiles": "node scripts/verify-operating-profile-flows.mjs",
    "verify:domain-flows": "node scripts/verify-domain-flows.mjs",
    "verify:office-modules": "node scripts/verify-office-module-flows.mjs",
    "verify:finance-document-extraction": "node --experimental-strip-types scripts/verify-finance-document-extraction.mjs",
    "verify:mission-resources": "node --experimental-strip-types scripts/verify-mission-resource-rules.mjs",
    "verify:material-fulfillment": "node --experimental-strip-types scripts/verify-material-fulfillment.mjs",
    "verify:material-pickup": "node scripts/verify-material-pickup-flow.mjs",
    "verify:mobile-navigation": "node --experimental-strip-types scripts/verify-mobile-navigation.mjs",
    "package:sites": "node scripts/package-sites-deployment.mjs",
    "verify:runtime": "node scripts/verify-runtime-smoke.mjs",
    "verify:http-surface": "node scripts/verify-http-surface.mjs",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@neondatabase/auth": "0.5.0-beta",
    "@neondatabase/serverless": "^1.1.0",
    "@shadcn/react": "^0.3.0",
    "@zxing/browser": "^0.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.3",
    "input-otp": "^1.4.2",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "next-themes": "^0.4.6",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/leaflet": "^1.9.22",
    "@types/node": "22.19.19",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.5",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
